# ============================================================
# DÍGALO CON FLORES — Variables de entorno del backend
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio.
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen público del sitio (el backend sirve también el frontend estático,
# así que en desarrollo es el mismo puerto que PORT)
FRONTEND_ORIGIN=http://localhost:4000

# --- Base de datos ---
# SQLite por defecto (cero configuración). Para producción, usar Postgres:
# DATABASE_URL="postgresql://usuario:password@host:5432/digaloconflores"
DATABASE_URL="file:./dev.db"

# --- Autenticación ---
# Cadena aleatoria larga. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=cambia-esto-por-una-cadena-aleatoria-larga-y-secreta
AUTH_COOKIE_NAME=dcf_session
AUTH_TOKEN_EXPIRES_IN=7d

# --- Credenciales del administrador inicial (usadas solo por prisma/seed.ts) ---
ADMIN_EMAIL=owner@digaloconflores.com
ADMIN_PASSWORD=cambia-esta-clave-antes-de-sembrar-datos

# --- WhatsApp Business (Meta Cloud API) ---
# Requiere una cuenta de WhatsApp Business API verificada en Meta for Developers.
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_NUMBER=

# --- Email (elige UN proveedor) ---
OWNER_EMAIL=owner@digaloconflores.com

# Opción A: SMTP genérico (Gmail, proveedor propio, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dígalo con Flores <no-reply@digaloconflores.com>"

# Opción B: Resend (si se define, tiene prioridad sobre SMTP)
RESEND_API_KEY=

# --- Almacenamiento de comprobantes y fotos de producto ---
UPLOAD_MAX_SIZE_MB=5
# Rutas de almacenamiento persistente. Vacío = usar carpetas dentro del repo (desarrollo).
# En producción (Railway u otro con volumen montado), apunta a ese volumen, ej.:
# UPLOADS_DIR=/data/uploads/receipts
# PRODUCT_IMAGES_DIR=/data/uploads/products
UPLOADS_DIR=
PRODUCT_IMAGES_DIR=

# --- Pagos futuros (no usado en la primera entrega, solo transferencia bancaria) ---
PAYMENT_PROVIDER_KEY=
STORAGE_PROVIDER_KEY=
